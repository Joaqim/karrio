              "schema": {
                "$ref": "#/components/schemas/QuoteGrossPriceModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteGrossPriceModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteGrossPriceModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteGrossPriceModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of prices for products",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceQuoteResult"
                  }
                }
