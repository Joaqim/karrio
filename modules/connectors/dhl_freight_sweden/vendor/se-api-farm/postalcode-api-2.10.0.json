          "fromStation": {
            "type": "string"
          },
          "toCountry": {
            "type": "string"
          },
          "gateway": {
            "type": "string"
          },
          "stationName": {
            "type": "string"
          },
          "linehaul": {
            "type": "string"
          },
          "linehaulExtension": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PostalCodeInfo": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PostalCodeInfoArrayResultWrapper": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "readOnly": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostalCodeInfo"
            },
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "PostalCodeRouteInfo": {
