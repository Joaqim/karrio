{
  "openapi": "3.0.4",
  "info": {
    "title": "Postalcode API",
    "version": "2.10.0"
  },
  "servers": [
    {
      "url": "https://test-api.freight-logistics.dhl.com/postalcodeapi/v1/"
    }
  ],
  "paths": {
    "/postalcodes/{countryCode}/{city}": {
      "get": {
        "tags": [
          "PostalCodes"
        ],
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of postal codes",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PostalCodeInfoArrayResultWrapper"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostalCodeInfoArrayResultWrapper"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostalCodeInfoArrayResultWrapper"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
