    "securitySchemes": {
      "Client key": {
        "type": "apiKey",
        "description": "Please insert your client key",
        "name": "client-key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Client key": [
        "client-key"
      ]
    }
  ],
  "tags": [
    {
      "name": "PostalCodes"
    }
  ]
}