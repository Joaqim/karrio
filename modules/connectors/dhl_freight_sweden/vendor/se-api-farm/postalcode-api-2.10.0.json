              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostalCodeGatewayInfo"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostalCodeGatewayInfo"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
