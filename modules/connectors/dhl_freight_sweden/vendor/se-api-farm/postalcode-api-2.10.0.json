    "/postalcodes/{countryCode}/{postalCode}/gateway": {
      "get": {
        "tags": [
          "PostalCodes"
        ],
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "postalCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toCountryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toPostalCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gateway information",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PostalCodeGatewayInfo"
