            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "lineHaul": {
            "type": "string"
          },
          "terminalId": {
            "type": "string"
          },
          "deviating": {
            "type": "string"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "bookable": {
            "type": "boolean"
          },
          "homeDeliveryParcel": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PostalCodeUpdateInfo": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "lineHaul": {
            "type": "string"
          },
          "terminalId": {
            "type": "string"
          },
          "deviating": {
            "type": "boolean"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "bookable": {
            "type": "boolean"
          },
          "deleted": {
            "type": "boolean"
          },
          "homeDeliveryParcel": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PostalCodeUpdateInfoArrayResultWrapper": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "readOnly": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostalCodeUpdateInfo"
            },
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "ValidationModel": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "allowDeviating": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
