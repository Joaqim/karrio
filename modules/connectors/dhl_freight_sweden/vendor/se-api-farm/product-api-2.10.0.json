            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toCountryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromCountryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of all package types",
