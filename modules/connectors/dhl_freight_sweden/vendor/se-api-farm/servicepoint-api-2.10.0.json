{
  "openapi": "3.0.4",
  "info": {
    "title": "Servicepoint API",
    "version": "2.10.0"
  },
  "servers": [
    {
      "url": "https://test-api.freight-logistics.dhl.com/servicepointlocatorapi/v1/"
    }
  ],
  "paths": {
    "/servicepoint/findnearestservicepoints": {
      "post": {
        "tags": [
          "ServicePoint"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/NearestServicePointRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NearestServicePointRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/NearestServicePointRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/NearestServicePointRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns nearest servicepoints that supports ",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NearestServicePointResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearestServicePointResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearestServicePointResponse"
                }
              }
            }
          }
        }
      }
    },
    "/servicepoint/getservicepointdetails/{servicePointId}": {
      "get": {
        "tags": [
          "ServicePoint"
        ],
        "parameters": [
          {
            "name": "servicePointId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get servicepoint details",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ServicePointDetailResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicePointDetailResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicePointDetailResponse"
                }
              }
            }
          }
        }
      }
    }
  },
